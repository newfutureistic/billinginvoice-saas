# Bill Maker — environment template (Mission 2: Database Foundation)
# Copy to `.env` and fill with your Supabase project values. `.env` is gitignored.

# --- Database (Supabase PostgreSQL) ---------------------------------------
# Pooled connection (PgBouncer, port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (port 5432) — used by `prisma migrate` / introspection only.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Runtime ---------------------------------------------------------------
# Node environment: development | test | production
NODE_ENV="development"

# Prisma query logging: "true" enables verbose query logs in development.
PRISMA_LOG_QUERIES="false"

# --- Auth.js (Mission 4: Authentication & Authorization) -------------------
# Secret used to sign/encrypt session JWTs & CSRF tokens. REQUIRED in production.
# Generate with:  npx auth secret   (or openssl rand -base64 33)
AUTH_SECRET="replace-with-a-32+-char-random-secret"
# Canonical app URL (used to build OAuth callback URLs). Optional in dev.
AUTH_URL="http://localhost:3000"
# Trust the host header (set "true" when running behind a proxy / on Vercel).
AUTH_TRUST_HOST="true"

# OAuth providers — leave blank to disable that button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Auth tuning (all optional; defaults shown) ----------------------------
BCRYPT_COST="12"                  # bcrypt work factor (10-15)
SESSION_MAX_AGE_DAYS="1"          # normal session lifetime
SESSION_REMEMBER_AGE_DAYS="30"    # "remember me" session lifetime
VERIFY_TOKEN_TTL_MIN="15"         # email verification code TTL
RESET_TOKEN_TTL_MIN="30"          # password reset token TTL
RESEND_COOLDOWN_SEC="30"          # throttle for resending verification codes
INVITE_TTL_DAYS="7"               # workspace invitation expiry
LOGIN_MAX_ATTEMPTS="5"            # failed logins before lockout
LOGIN_LOCK_MINUTES="15"           # lockout duration after too many failures

# --- Storage (Supabase Storage — Mission 7) --------------------------------
# Reuses your Supabase project. Service-role key is server-only (never expose client-side).
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""      # server-only; required for signed uploads + writes
SUPABASE_ANON_KEY=""              # optional fallback (read/public)
STORAGE_BUCKET="files"            # private bucket for tenant files (logos/avatars/pdfs/qr/attachments)
STORAGE_PUBLIC_BUCKET="public-assets"
SIGNED_URL_TTL_SEC="300"          # signed download URL lifetime

# --- Email (Resend — Mission 7) --------------------------------------------
RESEND_API_KEY=""                 # blank → emails are logged, not sent
EMAIL_FROM="Bill Maker <onboarding@resend.dev>"
EMAIL_REPLY_TO=""
APP_URL="http://localhost:3000"   # base URL for links in emails/PDFs (falls back to AUTH_URL)
