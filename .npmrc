# pnpm's default strict layout isolates packages behind symlinks. On Linux CI that made Next's
# server bundle resolve a React instance separate from the app's, so prerendering client
# components died with "Cannot read properties of null (reading 'useState')" on /_not-found,
# /dashboard and /_global-error — while local Windows builds passed, because pnpm cannot create
# real symlinks there and already falls back to a flat layout.
#
# Hoisting the linker gives every platform the same flat node_modules the Windows builds were
# verified against, so exactly one React is resolved everywhere.
node-linker=hoisted
